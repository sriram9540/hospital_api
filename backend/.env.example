# Copy to .env for local backend-only dev (this dir). Never commit real secrets.
# On Render, set these in the dashboard instead — no .env file needed.

# Neon Postgres connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Public frontend origin(s), comma-separated — backend CORS allowlist (required in prod)
FRONTEND_URL="https://your-frontend.onrender.com"

# Long random string for session token HMAC (required in prod; Render can generate it)
SESSION_SECRET="change-me-to-a-long-random-string"

# Render injects PORT automatically; local default is 3000
PORT="3000"
