# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospital?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hospital_test?schema=public"

# Session
SESSION_SECRET="change-me-in-production-32-bytes-min"

# Booking policy
CANCEL_CUTOFF_HOURS=2
REMINDER_POLL_MS=30000
NO_SHOW_LIMIT=3
TZ="Asia/Kolkata"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"
